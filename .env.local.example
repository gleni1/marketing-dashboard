# Supabase - get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key - for server-side operations (webhooks)
# Found in Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GHL Webhook Secret (optional but recommended)
# Set this to a random string and configure the same in GHL webhook settings
GHL_WEBHOOK_SECRET=your-webhook-secret
